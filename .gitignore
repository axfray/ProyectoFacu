# Entorno Virtual
venv/
env/
ENV/
.venv/

# Archivos temporales de Python (Caché)
__pycache__/
*.py[cod]
*$py.class

# Base de datos local SQLite (para no sobrescribir la base de datos de producción/pruebas de otros)
*.sqlite3
*.sqlite3-journal

# Archivos de configuración de entorno y secretos
.env
.DS_Store

# Archivos de configuración de editores de código (VS Code / PyCharm)
.vscode/
.idea/

# Archivos estáticos generados y subidas de usuarios (Media)
/staticfiles/
/media/